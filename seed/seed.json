	"content": {
		"homepage": [
			{
				"id": "homepage",
				"slug": "homepage",
				"status": "published",
				"data": {
					"title": "Homepage",
					"welcome_heading": "Welcome to Life at the Nest",
					"welcome_text": "Whether in the kitchen, garden, pasture, or design studio, I'm dedicated to upholding the cherished traditions of the \"make it from scratch\" philosophy. This legacy, passed down for generations, holds a special place in my heart, and I am thrilled to share it with you. Join me as we celebrate the art of craftsmanship together!",
					"about_heading": "Meet Audra",
					"about_text": [
						{
							"_type": "block",
							"_key": "a0",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "a0s",
									"text": "I inherited a unique perspective about self-sufficiency and resourcefulness as a child in rural Lancaster County, PA. Rooted in the traditions of my Pennsylvania Dutch great-grandparents, I learned from an early age the deep satisfaction of nurturing life from seed to harvest. In our community, where thrift was a virtue, we found beauty in simplicity and purpose in every task."
								}
							]
						},
						{
							"_type": "block",
							"_key": "a1",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "a1s",
									"text": "Guided by the wisdom of family and community, especially my beloved \"Amish Mom\" Fannie, I came to understand that true wealth lay not in possessions, but in the richness of family bonds and the bounty of the earth. Today, as the parent of five, I carry forward these cherished values, sowing the seeds of self-reliance and stewardship in our own children."
								}
							]
						},
						{
							"_type": "block",
							"_key": "a2",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "a2s",
									"text": "Warmly, Audra"
								}
							]
						}
					],
					"quotes": [
						{ "quote": "What you leave behind is not what is engraved in stone monuments, but what is woven into the lives of others.", "author": "Pericles" },
						{ "quote": "To plant a garden is to dream of tomorrow.", "author": "Audrey Hepburn" },
						{ "quote": "Sometimes the most important thing in a whole day is the rest we take between two deep breaths.", "author": "Etty Hillesum" },
						{ "quote": "The garden suggests there might be a place where we can meet nature halfway.", "author": "Michael Pollan" },
						{ "quote": "In his garden, every man may be his own artist without apology or explanation.", "author": "Louise Beebe Wilder" }
					]
				}
			}
		],
