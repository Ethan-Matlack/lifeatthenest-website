				"slug": "sample-buttermilk-biscuits",
				"status": "published",
				"data": {
					"title": "Sample: Buttermilk Biscuits",
					"summary": "Placeholder recipe for development. Tall, flaky biscuits with cold butter and buttermilk.",
					"servings": 8,
					"yield_unit": "biscuits",
					"prep_minutes": 15,
					"cook_minutes": 14,
					"difficulty": "Easy",
					"featured": true,
					"ingredients": [
						{ "amount": "2 1/2", "unit": "cup", "item": "all-purpose flour" },
						{ "amount": "1", "unit": "tbsp", "item": "baking powder" },
						{ "amount": "1/2", "unit": "tsp", "item": "baking soda" },
						{ "amount": "1", "unit": "tsp", "item": "salt", "fixed": true },
						{ "amount": "1/2", "unit": "cup", "item": "butter", "note": "very cold, cubed" },
						{ "amount": "1 1/4", "unit": "cup", "item": "buttermilk", "note": "cold" }
					],
					"steps": [
						{ "instruction": "Heat the oven to 450°F and line a baking sheet with parchment." },
						{ "instruction": "Whisk the flour, baking powder, baking soda, and salt. Cut in the butter until the pieces are the size of peas." },
						{ "instruction": "Stir in the buttermilk just until a shaggy dough forms. Pat out, fold in thirds twice, and cut into rounds." },
						{ "instruction": "Bake 12 to 14 minutes until tall and golden." }
					]
				},
				"taxonomies": {
					"course": ["bread", "breakfast"],
					"recipe_tag": ["quick"]
				}
			},
