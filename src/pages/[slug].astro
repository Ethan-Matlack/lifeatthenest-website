---
/**
 * Static pages from the Pages collection (About, Contact, …).
 * Title, optional photo, and rich-text body are all edited in the admin.
 * (Pages whose slug matches a real route, like "posts" or "recipes", are
 * read by those routes instead and never reach this file.)
 */
import { decodeSlug, getEmDashEntry, getSiteSettings } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import RichText from "../components/RichText.astro";
import { entrySeo } from "../utils/seo";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const [{ entry: page, cacheHint }, settings] = await Promise.all([
	getEmDashEntry("pages", slug),
	getSiteSettings(),
]);
if (!page) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const d = page.data;
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = entrySeo(page, { siteTitle, url: Astro.url, image: d.photo, publicMediaUrl: Astro.locals.emdash?.getPublicMediaUrl });
---

<Base
	title={d.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "pages", id: d.id, slug }}
	fullBleed
>
	<article class="page">
		<header class="container container--prose page-header">
			{
				d.photo && (
					<div class="page-photo arch" {...page.edit.photo}>
						<Image image={d.photo} sizes="18rem" priority />
					</div>
				)
			}
			<h1 {...page.edit.title}>{d.title}</h1>
		</header>

		<div class="container container--prose page-body">
			<RichText value={d.content} class="page-content" {...page.edit.content} />
		</div>
	</article>
</Base>

<style>
	.page-header {
		padding-block: var(--space-xl) var(--space-lg);
		text-align: center;
	}

	.page-header h1 {
		margin: 0;
	}

	/* Arched portrait, like the homepage frames */
	.page-photo {
		width: min(60%, 18rem);
		aspect-ratio: 4 / 5;
		margin: 0 auto var(--space-lg);
		overflow: hidden;
		border-radius: 999px 999px var(--radius-lg) var(--radius-lg);
	}

	.page-photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.page-body {
		padding-bottom: var(--space-2xl);
	}

	/* A short final paragraph (a sign-off like "Warmly, Audra") keeps its line break. */
	.page-body :global(.page-content > p:last-child) {
		white-space: pre-line;
	}
</style>
