---
import { decodeSlug, getEmDashCollection, getEmDashEntry, getSiteSettings } from "emdash";
import { Image } from "emdash/ui";
import { Comments, CommentForm } from "emdash/ui/comments";
import Base from "../../layouts/Base.astro";
import BackToTop from "../../components/BackToTop.astro";
import PostNav from "../../components/PostNav.astro";
import ShopThis from "../../components/ShopThis.astro";
import RichText from "../../components/RichText.astro";
import VideoList from "../../components/VideoList.astro";
import { formatDate } from "../../utils/format";
import { readingMinutes } from "../../utils/portable-text";
import { entrySeo } from "../../utils/seo";
import { videoEntries } from "../../utils/video";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const AUTHOR = "Audra Chalfant Matlack";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug, {
	references: { featured_products: true },
});
if (!post) return Astro.rewrite("/404");

const d = post.data;
const published = d.publishedAt;

// Neighbors in publish order, across all categories.
const [olderResult, newerResult, settings] = await Promise.all([
	published
		? getEmDashCollection("posts", {
				where: { published_at: { lt: published.toISOString() } },
				orderBy: { published_at: "desc" },
				limit: 1,
			})
		: null,
	published
		? getEmDashCollection("posts", {
				where: { published_at: { gt: published.toISOString() } },
				orderBy: { published_at: "asc" },
				limit: 1,
			})
		: null,
	getSiteSettings(),
]);

if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	if (olderResult) Astro.cache.set(olderResult.cacheHint);
	if (newerResult) Astro.cache.set(newerResult.cacheHint);
}

const toNav = (entry?: (typeof olderResult & {})["entries"][number]) =>
	entry ? { href: `/posts/${entry.id}`, title: entry.data.title, image: entry.data.featured_image } : null;
const previous = toNav(olderResult?.entries[0]);
const next = toNav(newerResult?.entries[0]);

const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = entrySeo(post, { siteTitle, url: Astro.url, description: d.excerpt, image: d.featured_image, publicMediaUrl: Astro.locals.emdash?.getPublicMediaUrl });

const categories = d.terms?.category ?? [];
const tags = d.terms?.tag ?? [];
const products = post.references?.featured_products?.entries ?? [];
const minutes = readingMinutes(d.content);
const videos = videoEntries(d);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "posts", id: d.id, slug }}
	pageType="article"
	articleMeta={{
		publishedTime: published?.toISOString() ?? null,
		modifiedTime: d.updatedAt?.toISOString() ?? null,
		author: AUTHOR,
	}}
	fullBleed
>
	<article class="post">
		<header class="container container--prose post-header">
			{
				categories.length > 0 && (
					<p class="post-categories">
						{categories.map((c, i) => (
							<>
								{i > 0 && <span aria-hidden="true"> · </span>}
								<a class="eyebrow post-category" href={`/posts?category=${c.slug}`}>
									{c.label}
								</a>
							</>
						))}
					</p>
				)
			}
			<h1 {...post.edit.title}>{d.title}</h1>
			<p class="post-meta">
				{published && <time datetime={published.toISOString()}>{formatDate(published)}</time>}
				{published && <span aria-hidden="true">·</span>}
				<span>{minutes} min read</span>
			</p>
		</header>

		{
			d.featured_image && (
				<div class="post-hero" {...post.edit.featured_image}>
					<Image
						image={d.featured_image}
						sizes="(min-width: 64rem) 60rem, 100vw"
						priority
					/>
				</div>
			)
		}

		<div class="container container--prose post-body">
			<RichText value={d.content} {...post.edit.content} />

			{
				videos.length > 0 && (
					<section class="post-video" aria-labelledby="post-video-heading">
						<h2 id="post-video-heading" class="post-video-title">
							Watch
						</h2>
						<VideoList videos={videos} />
					</section>
				)
			}

			{
				tags.length > 0 && (
					<ul class="post-tags" aria-label="Tags">
						{tags.map((t) => (
							<li>
								<a class="chip" href={`/posts?tag=${t.slug}`}>
									#{t.label}
								</a>
							</li>
						))}
					</ul>
				)
			}
		</div>
	</article>

	<ShopThis products={products} eyebrow="Shop this post" />

	<div class="container post-end">
		<PostNav previous={previous} next={next} />
	</div>

	<section class="container container--prose post-comments comments-section" aria-labelledby="comments-heading">
		<h2 id="comments-heading" class="visually-hidden">Comments</h2>
		<Comments collection="posts" contentId={d.id} threaded />
		<h3 class="comment-form-heading">Leave a comment</h3>
		<CommentForm collection="posts" contentId={d.id} />
	</section>

	<BackToTop />
</Base>

<style>
	.post-header {
		padding-block: var(--space-xl) var(--space-lg);
		text-align: center;
	}

	.post-categories {
		margin-bottom: var(--space-2xs);
		color: var(--color-moss);
	}

	.post-category {
		margin: 0;
		text-decoration: none;
	}

	.post-header h1 {
		margin-bottom: var(--space-sm);
		font-size: clamp(2.1rem, 1.6rem + 2.4vw, 3.4rem);
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		margin: 0;
		font-size: var(--text-sm);
		color: var(--color-muted);
	}

	.post-hero {
		width: min(60rem, 100%);
		margin: 0 auto var(--space-xl);
	}

	.post-hero :global(img) {
		width: 100%;
		max-height: 75vh;
		object-fit: cover;
	}

	@media (min-width: 60rem) {
		.post-hero :global(img) {
			border-radius: var(--radius-lg);
		}
	}

	.post-body {
		padding-bottom: var(--space-xl);
	}

	.post-video {
		margin-top: var(--space-xl);
		padding-top: var(--space-lg);
		border-top: 1px solid var(--color-border);
	}

	.post-video-title {
		margin: 0 0 var(--space-sm);
		font-size: var(--text-xl);
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2xs);
		margin: var(--space-xl) 0 0;
		padding: var(--space-md) 0 0;
		border-top: 1px solid var(--color-border);
		list-style: none;
	}

	.post-end {
		max-width: calc(60rem + var(--gutter) * 2);
		padding-block: var(--space-xl);
	}

	.post-comments {
		padding-bottom: var(--space-2xl);
	}

	.comment-form-heading {
		margin-top: var(--space-xl);
		font-size: var(--text-xl);
	}
</style>
