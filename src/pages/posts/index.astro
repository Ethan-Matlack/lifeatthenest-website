---
/**
 * Blog index: category chips, year filter, search, and infinite scroll.
 * Query params: ?category=&tag=&year=&q=&cursor=
 * Without a search, posts are newest first; with one, best match first.
 */
import { getEmDashCollection, getSeoMeta, getTaxonomyTermsWithCacheHint, getTerm, search } from "emdash";
import type { ContentEntry, WhereValue } from "emdash";
import type { Post } from "../../../emdash-env";
import Base from "../../layouts/Base.astro";
import BackToTop from "../../components/BackToTop.astro";
import ListingFilters from "../../components/ListingFilters.astro";
import LoadMore from "../../components/LoadMore.astro";
import PostCard from "../../components/PostCard.astro";
import { listingUrl, param, sortBySlugRank } from "../../utils/listing";
import { getListingPage } from "../../utils/listing-page";
import RichText from "../../components/RichText.astro";

const BASE = "/posts";
const PAGE_SIZE = 12;
const SEARCH_LIMIT = 50;

const params = Astro.url.searchParams;
const categorySlug = param(params, "category");
const tagSlug = param(params, "tag");
const q = param(params, "q", 100);
const yearParam = param(params, "year", 4);
const year = /^\d{4}$/.test(yearParam) ? Number(yearParam) : null;
const cursor = param(params, "cursor", 500) || undefined;

const [categoriesResult, oldestResult, tagTerm] = await Promise.all([
	getTaxonomyTermsWithCacheHint("category"),
	getEmDashCollection("posts", { orderBy: { published_at: "asc" }, limit: 1 }),
	tagSlug ? getTerm("tag", tagSlug) : Promise.resolve(null),
]);

const categories = categoriesResult.data.filter((t) => !t.parentId);
const activeCategory = categories.find((c) => c.slug === categorySlug) ?? null;

// Year options run from the oldest post's year to this year.
const thisYear = new Date().getFullYear();
const oldestYear = oldestResult.entries[0]?.data.publishedAt?.getFullYear() ?? thisYear;
const years: number[] = [];
for (let y = thisYear; y >= oldestYear; y--) years.push(y);

// Heading, intro, and SEO come from the matching entry in Pages (slug "posts").
const page = await getListingPage("posts", {
	title: "The Blog",
	intro: "Stories from our kitchen, garden, pasture, studio, and family.",
});
if (Astro.cache?.enabled) Astro.cache.set(page.cacheHint);

const state = { category: activeCategory?.slug, tag: tagTerm?.slug, year, q };
const url = (overrides = {}) => listingUrl(BASE, state, overrides);

const where: Record<string, WhereValue> = {};
if (activeCategory) where.category = activeCategory.slug;
if (tagTerm) where.tag = tagTerm.slug;
if (year) where.published_at = { gte: `${year}-01-01`, lt: `${year + 1}-01-01` };

let posts: ContentEntry<Post>[] = [];
let nextCursor: string | undefined;
let loadFailed = false;

if (q) {
	// Full-text search, then the other filters in the database; keep relevance order.
	const results = await search(q, { collections: ["posts"], limit: SEARCH_LIMIT });
	const slugs = results.items.map((r) => r.slug).filter((s): s is string => Boolean(s));
	if (slugs.length > 0) {
		const res = await getEmDashCollection("posts", { where: { ...where, slug: slugs }, limit: SEARCH_LIMIT });
		if (Astro.cache?.enabled) Astro.cache.set(res.cacheHint);
		posts = sortBySlugRank(res.entries, slugs);
	}
} else {
	const res = await getEmDashCollection("posts", {
		where,
		orderBy: { published_at: "desc" },
		limit: PAGE_SIZE,
		cursor,
	});
	if (res.error) {
		// A stale or hand-edited cursor: start the same filtered list over.
		if (cursor) return Astro.redirect(url(), 302);
		loadFailed = true;
	}
	if (Astro.cache?.enabled) Astro.cache.set(res.cacheHint);
	posts = res.entries;
	nextCursor = res.nextCursor;
}

if (Astro.cache?.enabled) {
	Astro.cache.set(categoriesResult.cacheHint);
	Astro.cache.set(oldestResult.cacheHint);
}

const active = [
	activeCategory && {
		label: activeCategory.label,
		removeHref: url({ category: null }),
		removeLabel: `Remove category filter: ${activeCategory.label}`,
	},
	tagTerm && {
		label: `#${tagTerm.label}`,
		removeHref: url({ tag: null }),
		removeLabel: `Remove tag filter: ${tagTerm.label}`,
	},
	year && { label: String(year), removeHref: url({ year: null }), removeLabel: `Remove year filter: ${year}` },
	q && { label: `“${q}”`, removeHref: url({ q: null }), removeLabel: `Remove search: ${q}` },
].filter((f) => Boolean(f)) as { label: string; removeHref: string; removeLabel: string }[];

const titleParts = [activeCategory?.label, tagTerm?.label, year?.toString()].filter(Boolean);
// The page's SEO panel applies to the unfiltered listing only.
const seo =
	page.entry && !activeCategory && !q
		? getSeoMeta(page.entry, { siteTitle: "Life at the Nest", siteUrl: Astro.url.origin, path: "/posts" })
		: null;
const pageTitle = titleParts.length ? `${titleParts.join(" · ")} — Blog` : page.title;
const description = activeCategory?.description ?? seo?.description ?? page.introText;
// Search results and "load more" pages shouldn't compete with the main listing.
const canonical = new URL(url({ q: null }), Astro.url).toString();
---

<Base title={pageTitle} description={description} canonical={canonical} image={seo?.ogImage ?? null}>
	<header class="listing-header">
		{
			activeCategory ? (
				<h1>{activeCategory.label}</h1>
			) : (
				<h1 {...page.entry?.edit.title}>{page.title}</h1>
			)
		}
		{
			activeCategory ? (
				<p class="listing-intro">{activeCategory.description ?? page.fallbackIntro}</p>
			) : page.content ? (
				<RichText value={page.content} class="listing-intro" {...page.entry?.edit.content} />
			) : (
				<p class="listing-intro">{page.fallbackIntro}</p>
			)
		}
	</header>

	<ListingFilters
		action={BASE}
		state={state}
		search={{
			value: q,
			label: "Search posts",
			placeholder: activeCategory
				? `Search ${activeCategory.label.replace(/^In the /i, "")} posts`
				: "Search all posts",
		}}
		chips={{
			label: "Blog categories",
			items: [
				{ label: "All", href: url({ category: null }), current: !activeCategory },
				...categories.map((c) => ({
					label: c.label,
					href: url({ category: c.slug }),
					current: activeCategory?.slug === c.slug,
				})),
			],
		}}
		select={{
			name: "year",
			label: "Year",
			anyLabel: "Any year",
			options: years.map((y) => ({ value: String(y), label: String(y) })),
			value: year ? String(year) : "",
		}}
		active={active}
		clearHref={BASE}
		panelCount={[activeCategory, year].filter(Boolean).length}
	/>

	{
		posts.length > 0 ? (
			<div class="card-grid post-grid" id="post-grid">
				{posts.map((post) => (
					<PostCard post={post} headingLevel="h2" />
				))}
			</div>
		) : (
			<div class="listing-empty">
				<h2>{loadFailed ? "Something went wrong" : "No posts found"}</h2>
				<p>
					{loadFailed
						? "We couldn't load the posts. Please try again."
						: active.length
							? "Nothing matches those filters yet. Try another category or year."
							: "There are no posts yet. Check back soon!"}
				</p>
				{active.length > 0 && (
					<a class="btn btn--outline" href={BASE}>
						See all posts
					</a>
				)}
			</div>
		)
	}

	<LoadMore nextUrl={nextCursor ? url({ cursor: nextCursor }) : null} gridId="post-grid" noun="posts" />
	{
		q && posts.length >= SEARCH_LIMIT && (
			<p class="listing-note">Showing the top {SEARCH_LIMIT} matches. Try a more specific search.</p>
		)
	}
	<BackToTop />
</Base>

<style>
	.post-grid {
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
		gap: var(--space-xl) var(--space-md);
	}
</style>
