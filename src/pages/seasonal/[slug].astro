---
/**
 * One seasonal roundup page (e.g. "Thanksgiving at the Nest"): title,
 * season, short description, main photo, intro, then the recipes, blog
 * posts, and products Audra picked, in the order she arranged them.
 * Content type: Seasonal (scripts/create-seasonal.mjs, seed/seed.json).
 */
import { decodeSlug, getEmDashCollection, getEmDashEntry, getSiteSettings } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import BackToTop from "../../components/BackToTop.astro";
import NewsletterCta from "../../components/NewsletterCta.astro";
import PostCard from "../../components/PostCard.astro";
import RecipeTile from "../../components/RecipeTile.astro";
import RichText from "../../components/RichText.astro";
import ShopThis from "../../components/ShopThis.astro";
import { entrySeo } from "../../utils/seo";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const [{ entry: page, cacheHint }, settings] = await Promise.all([
	getEmDashEntry("seasonal", slug, { references: { recipes: true, posts: true, products: true } }),
	getSiteSettings(),
]);
if (!page) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const d = page.data;
const refs = page.references;

/**
 * Picked entries come back without taxonomy terms, which the cards show
 * (category labels). Re-load them in one query per type, keeping the
 * editor's order. Products have no terms on their cards, so they're used as is.
 */
async function withTerms<C extends "recipes" | "posts">(collection: C, picked: { id: string }[] | undefined) {
	const slugs = (picked ?? []).map((e) => e.id);
	if (!slugs.length) return [];
	const { entries, cacheHint: hint } = await getEmDashCollection(collection, { where: { slug: slugs }, limit: slugs.length });
	if (Astro.cache?.enabled) Astro.cache.set(hint);
	const byId = new Map(entries.map((e) => [e.id, e]));
	return slugs.flatMap((s) => byId.get(s) ?? []);
}

const [recipes, posts] = await Promise.all([withTerms("recipes", refs?.recipes?.entries), withTerms("posts", refs?.posts?.entries)]);
const products = refs?.products?.entries ?? [];

const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = entrySeo(page, {
	siteTitle,
	url: Astro.url,
	description: d.summary,
	image: d.hero_image,
	publicMediaUrl: Astro.locals.emdash?.getPublicMediaUrl,
});
const hasIntro = Array.isArray(d.intro) && d.intro.length > 0;
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "seasonal", id: d.id, slug }}
	fullBleed
>
	<article class="seasonal">
		<header class="container container--prose seasonal-header">
			<span class="eyebrow" {...page.edit.season}>{d.season ?? "Seasonal"}</span>
			<h1 {...page.edit.title}>{d.title}</h1>
			{d.summary && <p class="seasonal-summary" {...page.edit.summary}>{d.summary}</p>}
		</header>

		{
			d.hero_image && (
				<div class="seasonal-hero" {...page.edit.hero_image}>
					<Image image={d.hero_image} sizes="(min-width: 64rem) 60rem, 100vw" priority />
				</div>
			)
		}

		{
			hasIntro && (
				<div class="container container--prose seasonal-intro">
					<RichText value={d.intro} {...page.edit.intro} />
				</div>
			)
		}

		{
			recipes.length > 0 && (
				<section class="section" aria-labelledby="seasonal-recipes">
					<div class="container">
						<div class="section-heading">
							<h2 id="seasonal-recipes">Recipes</h2>
						</div>
						<div class="card-grid seasonal-recipes">
							{recipes.map((recipe) => (
								<RecipeTile recipe={recipe} />
							))}
						</div>
					</div>
				</section>
			)
		}

		{
			posts.length > 0 && (
				<section class="section" aria-labelledby="seasonal-posts">
					<div class="container">
						<div class="section-heading">
							<h2 id="seasonal-posts">From the Blog</h2>
						</div>
						<div class="card-grid seasonal-posts">
							{posts.map((post) => (
								<PostCard post={post} />
							))}
						</div>
					</div>
				</section>
			)
		}
	</article>

	<ShopThis products={products} eyebrow="Shop the season" />

	<NewsletterCta />

	<BackToTop />
</Base>

<style>
	.seasonal-header {
		padding-block: var(--space-xl) var(--space-lg);
		text-align: center;
	}

	.seasonal-header h1 {
		margin-bottom: var(--space-sm);
		font-size: clamp(2.1rem, 1.6rem + 2.4vw, 3.4rem);
	}

	.seasonal-summary {
		max-width: 36rem;
		margin: 0 auto;
		font-size: var(--text-lg);
		color: var(--color-muted);
	}

	.seasonal-hero {
		width: min(60rem, 100%);
		aspect-ratio: 16 / 9;
		margin: 0 auto var(--space-xl);
		overflow: hidden;
	}

	.seasonal-hero :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (min-width: 60rem) {
		.seasonal-hero {
			border-radius: var(--radius-lg);
		}
	}

	.seasonal-intro {
		padding-bottom: var(--space-lg);
	}

	/* Same layouts as the homepage: two-up recipe tiles on phones. */
	.seasonal-recipes {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-sm);
	}

	@media (min-width: 40rem) {
		.seasonal-recipes {
			grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
			gap: var(--space-lg) var(--space-md);
		}
	}

	.seasonal-posts {
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
	}
</style>
