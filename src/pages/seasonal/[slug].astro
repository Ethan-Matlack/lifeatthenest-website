---
/**
 * One seasonal roundup page (e.g. "Thanksgiving at the Nest"): title,
 * short description, main photo, intro, then its collection.
 *
 * The collection is automatic: the page is tagged with a "Seasonal
 * Collections" term (taxonomy `seasonal`, shared by posts, recipes, products
 * and seasonal pages), and lists every published recipe and blog post with
 * the same term in one mixed grid ("Recipe" / "Story" tiles), newest first,
 * plus products (newest first) in the shop strip. Pinned recipes, then
 * pinned posts, come first in the order Audra arranged them.
 * Setup: scripts/create-seasonal.mjs, seed/seed.json.
 */
import { decodeSlug, getEmDashCollection, getEmDashEntry, getSiteSettings } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import BackToTop from "../../components/BackToTop.astro";
import NewsletterCta from "../../components/NewsletterCta.astro";
import PostTile from "../../components/PostTile.astro";
import RecipeTile from "../../components/RecipeTile.astro";
import RichText from "../../components/RichText.astro";
import ShopThis from "../../components/ShopThis.astro";
import { entrySeo } from "../../utils/seo";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const [{ entry: page, cacheHint }, settings] = await Promise.all([
	getEmDashEntry("seasonal", slug, { references: { pinned_recipes: true, pinned_posts: true } }),
	getSiteSettings(),
]);
if (!page) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const d = page.data;

const term = d.terms?.seasonal?.[0]?.slug;
const LIMIT = 100;
const cache = (hint: unknown) => {
	if (Astro.cache?.enabled && hint) Astro.cache.set(hint as Parameters<typeof Astro.cache.set>[0]);
};

/**
 * Pinned entries come back without taxonomy terms, which the cards show
 * (category labels), so re-load them in one query, keeping the pin order.
 */
async function loadPinned<C extends "recipes" | "posts">(collection: C, pinned: { id: string }[] | undefined) {
	const slugs = (pinned ?? []).map((e) => e.id);
	if (!slugs.length) return [];
	const { entries, cacheHint: hint } = await getEmDashCollection(collection, { where: { slug: slugs }, limit: slugs.length });
	cache(hint);
	const byId = new Map(entries.map((e) => [e.id, e]));
	return slugs.flatMap((s) => byId.get(s) ?? []);
}

/** Everything tagged with this page's collection term. */
async function loadTagged<C extends "recipes" | "posts" | "products">(collection: C, orderBy: Record<string, "asc" | "desc">) {
	if (!term) return [];
	const { entries, cacheHint: hint } = await getEmDashCollection(collection, { where: { seasonal: term }, orderBy, limit: LIMIT });
	cache(hint);
	return entries;
}

const [pinnedRecipes, pinnedPosts, taggedRecipes, taggedPosts, products] = await Promise.all([
	loadPinned("recipes", page.references?.pinned_recipes?.entries),
	loadPinned("posts", page.references?.pinned_posts?.entries),
	loadTagged("recipes", { published_at: "desc" }),
	loadTagged("posts", { published_at: "desc" }),
	loadTagged("products", { created_at: "desc" }),
]);
// One mixed grid: pins first (recipes, then posts, each in pin order), then
// everything else tagged, newest first.
type Item =
	| { kind: "recipe"; entry: (typeof taggedRecipes)[number] }
	| { kind: "post"; entry: (typeof taggedPosts)[number] };
const pinnedIds = new Set([...pinnedRecipes, ...pinnedPosts].map((e) => e.id));
const published = (i: Item) => i.entry.data.publishedAt?.getTime() ?? 0;
const items: Item[] = [
	...pinnedRecipes.map((entry) => ({ kind: "recipe" as const, entry })),
	...pinnedPosts.map((entry) => ({ kind: "post" as const, entry })),
	...[
		...taggedRecipes.filter((e) => !pinnedIds.has(e.id)).map((entry) => ({ kind: "recipe" as const, entry })),
		...taggedPosts.filter((e) => !pinnedIds.has(e.id)).map((entry) => ({ kind: "post" as const, entry })),
	].sort((a, b) => published(b) - published(a)),
];

const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = entrySeo(page, {
	siteTitle,
	url: Astro.url,
	description: d.summary,
	image: d.hero_image,
	publicMediaUrl: Astro.locals.emdash?.getPublicMediaUrl,
});
const hasIntro = Array.isArray(d.intro) && d.intro.length > 0;
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "seasonal", id: d.id, slug }}
	fullBleed
>
	<article class="seasonal">
		<header class="container container--prose seasonal-header">
			<a class="eyebrow seasonal-eyebrow" href="/seasonal">Seasonal</a>
			<h1 {...page.edit.title}>{d.title}</h1>
			{d.summary && <p class="seasonal-summary" {...page.edit.summary}>{d.summary}</p>}
		</header>

		{
			d.hero_image && (
				<div class="seasonal-hero" {...page.edit.hero_image}>
					<Image image={d.hero_image} sizes="(min-width: 64rem) 60rem, 100vw" priority />
				</div>
			)
		}

		{
			hasIntro && (
				<div class="container container--prose seasonal-intro">
					<RichText value={d.intro} {...page.edit.intro} />
				</div>
			)
		}

		{
			items.length > 0 && (
				<section class="section" aria-label="Recipes and stories">
					<div class="container">
						<div class="card-grid seasonal-grid">
							{items.map((item) =>
								item.kind === "recipe" ? (
									<RecipeTile recipe={item.entry} typeLabel="Recipe" />
								) : (
									<PostTile post={item.entry} typeLabel="Story" />
								),
							)}
						</div>
					</div>
				</section>
			)
		}
	</article>

	<ShopThis products={products} eyebrow="Shop the season" />

	<NewsletterCta />

	<BackToTop />
</Base>

<style>
	.seasonal-header {
		padding-block: var(--space-xl) var(--space-lg);
		text-align: center;
	}

	.seasonal-eyebrow {
		text-decoration: none;
	}

	.seasonal-header h1 {
		margin-bottom: var(--space-sm);
		font-size: clamp(2.1rem, 1.6rem + 2.4vw, 3.4rem);
	}

	.seasonal-summary {
		max-width: 36rem;
		margin: 0 auto;
		font-size: var(--text-lg);
		color: var(--color-muted);
	}

	.seasonal-hero {
		width: min(60rem, 100%);
		aspect-ratio: 16 / 9;
		margin: 0 auto var(--space-xl);
		overflow: hidden;
	}

	.seasonal-hero :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (min-width: 60rem) {
		.seasonal-hero {
			border-radius: var(--radius-lg);
		}
	}

	.seasonal-intro {
		padding-bottom: var(--space-lg);
	}

	/* Same layout as the homepage recipe tiles: two-up on phones. */
	.seasonal-grid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-sm);
	}

	@media (min-width: 40rem) {
		.seasonal-grid {
			grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
			gap: var(--space-lg) var(--space-md);
		}
	}
</style>
