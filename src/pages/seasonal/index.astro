---
/**
 * /seasonal: the Seasonal landing page.
 *
 *  - Featured: the page with "Feature now" on (newest published if several).
 *  - Then one grid of every other seasonal page, in the order of their
 *    Seasonal Collections tags (Admin -> Seasonal Collections -> a tag's ...
 *    menu -> Move up / Move down). Untagged pages come last, newest first.
 *
 * Heading and intro come from the Pages entry with slug "seasonal" (fallback
 * text below if it doesn't exist), like the Blog/Recipes/Shop listings.
 */
import { getEmDashCollection, getSeoMeta, getTaxonomyTermsWithCacheHint } from "emdash";
import Base from "../../layouts/Base.astro";
import RichText from "../../components/RichText.astro";
import SeasonalCard from "../../components/SeasonalCard.astro";
import { getListingPage } from "../../utils/listing-page";

const [page, { entries, cacheHint }, termsResult] = await Promise.all([
	getListingPage("seasonal", {
		title: "Seasonal",
		intro: "Recipes, projects, and stories gathered for each season and holiday at the Nest.",
	}),
	getEmDashCollection("seasonal", { orderBy: { published_at: "desc" }, limit: 100 }),
	getTaxonomyTermsWithCacheHint("seasonal"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(termsResult.cacheHint);
	if (page.cacheHint) Astro.cache.set(page.cacheHint);
}

const featured = entries.find((e) => e.data.featured) ?? null;
const rest = entries.filter((e) => e !== featured);

// Position of each tag in the admin's manual order; a page sorts by its
// earliest tag. Ties and untagged pages keep newest-first (stable sort).
const position = new Map(termsResult.data.map((t, i) => [t.slug, i]));
const rank = (e: (typeof rest)[number]) =>
	Math.min(...(e.data.terms?.seasonal ?? []).map((t) => position.get(t.slug) ?? Infinity), Infinity);
const others = [...rest].sort((a, b) => rank(a) - rank(b));

const seo = page.entry
	? getSeoMeta(page.entry, { siteTitle: "Life at the Nest", siteUrl: Astro.url.origin, path: "/seasonal" })
	: null;
---

<Base
	title={page.title}
	description={seo?.description ?? page.introText}
	canonical={new URL("/seasonal", Astro.url).toString()}
	image={seo?.ogImage ?? null}
>
	<header class="listing-header">
		<h1 {...page.entry?.edit.title}>{page.title}</h1>
		{
			page.content ? (
				<RichText value={page.content} class="listing-intro" {...page.entry?.edit.content} />
			) : (
				<p class="listing-intro">{page.fallbackIntro}</p>
			)
		}
	</header>

	{
		featured && (
			<section class="seasonal-featured" aria-label="Featured">
				<SeasonalCard page={featured} featured headingLevel="h2" priority />
			</section>
		)
	}

	{
		others.length > 0 && (
			<section class="seasonal-others" aria-label="All seasonal collections">
				<div class="card-grid">
					{others.map((p) => (
						<SeasonalCard page={p} headingLevel="h2" />
					))}
				</div>
			</section>
		)
	}

	{
		entries.length === 0 && (
			<div class="listing-empty">
				<p>Seasonal collections are coming soon. Check back!</p>
			</div>
		)
	}
</Base>

<style>
	.seasonal-featured {
		margin-bottom: var(--space-2xl);
	}

</style>
