---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import LocalNotice from "../components/LocalNotice.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** Skip the default centered container so the page can lay out full-bleed sections */
	fullBleed?: boolean;
	/** "article" for posts/recipes (enables BlogPosting JSON-LD and og:type article) */
	pageType?: "website" | "article";
	articleMeta?: { publishedTime?: string | null; modifiedTime?: string | null; author?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	content,
	fullBleed = false,
	pageType = "website",
	articleMeta,
} = Astro.props;
const [settingsResult, menuResult, socialResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getMenuWithCacheHint("social"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
	Astro.cache.set(socialResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const navItems = menuResult.data?.items ?? [];
const socialItems = socialResult.data?.items ?? [];

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType,
	articleMeta,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#fdfbf8" />
		<title>{fullTitle}</title>
		<Font cssVariable="--font-display" preload />
		<Font cssVariable="--font-body" preload />
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main">Skip to content</a>
		<LocalNotice />

		<SiteHeader
			siteTitle={siteTitle}
			siteTagline={siteTagline}
			logo={siteLogo}
			items={navItems}
		/>

		<main id="main" class:list={["site-main", { container: !fullBleed }]}>
			<slot />
		</main>

		<SiteFooter
			siteTitle={siteTitle}
			siteTagline={siteTagline}
			socialItems={socialItems}
		/>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>

<style>
	.site-main {
		flex: 1 0 auto;
		width: 100%;
	}

	.site-main.container {
		padding-block: var(--space-xl) var(--space-2xl);
	}
</style>
