---
/**
 * Photo card linking to a recipe. Used on the homepage, recipe index,
 * and course/tag pages. (The full printable card is RecipeCard.)
 */
import { Image } from "emdash/ui";
import type { ContentEntry } from "emdash";
import type { Recipe } from "../../emdash-env";
import { formatMinutes, totalMinutes } from "../utils/format";

interface Props {
	recipe: ContentEntry<Recipe>;
	/** Heading level for the title, so the card fits the page outline */
	headingLevel?: "h2" | "h3";
	priority?: boolean;
}

const { recipe, headingLevel = "h3", priority = false } = Astro.props;
const d = recipe.data;
const Heading = headingLevel;
const course = d.terms?.course?.[0]?.label;
const time = formatMinutes(totalMinutes(d.prep_minutes, d.cook_minutes, d.extra_minutes));
---

<article class="recipe-tile">
	<a class="tile-link" href={`/recipes/${recipe.id}`}>
		<div class="tile-media">
			{
				d.hero_image ? (
					<Image
						image={d.hero_image}
						alt=""
						sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 100vw"
						priority={priority}
					/>
				) : (
					<div class="photo-placeholder" aria-hidden="true" />
				)
			}
		</div>
		<div class="tile-body">
			{course && <span class="eyebrow">{course}</span>}
			<Heading class="tile-title">{d.title}</Heading>
			{time && <p class="tile-meta">{time}</p>}
		</div>
	</a>
</article>

<style>
	.recipe-tile {
		height: 100%;
	}

	.tile-link {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		color: inherit;
		text-decoration: none;
		transition:
			box-shadow 0.2s ease,
			transform 0.2s ease;
	}

	.tile-link:hover {
		box-shadow: var(--shadow-md);
		transform: translateY(-2px);
		color: inherit;
	}

	.tile-media {
		aspect-ratio: 4 / 3;
		overflow: hidden;
	}

	.tile-media :global(img),
	.tile-media .photo-placeholder {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.tile-body {
		padding: var(--space-xs) var(--space-sm) var(--space-sm);
	}

	@media (min-width: 40rem) {
		.tile-body {
			padding: var(--space-sm) var(--space-md) var(--space-md);
		}
	}

	.tile-body .eyebrow {
		margin-bottom: var(--space-3xs);
	}

	.tile-title {
		margin: 0;
		font-size: clamp(1.05rem, 0.9rem + 0.8vw, 1.6rem);
		line-height: var(--leading-snug);
	}

	.tile-link:hover .tile-title {
		color: var(--color-moss);
	}

	.tile-meta {
		margin: var(--space-2xs) 0 0;
		font-size: var(--text-sm);
		color: var(--color-muted);
	}
</style>
