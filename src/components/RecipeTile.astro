---
/**
 * Photo card linking to a recipe. Used on the homepage, recipe index,
 * filtered views, and seasonal pages. (The full printable card is
 * RecipeCard.) The look is shared with PostTile via ContentTile.
 */
import type { ContentEntry } from "emdash";
import type { Recipe } from "../../emdash-env";
import ContentTile from "./ContentTile.astro";
import { SLOTS } from "../utils/image-slots";
import { formatMinutes, totalMinutes } from "../utils/format";

interface Props {
	recipe: ContentEntry<Recipe>;
	/** Heading level for the title, so the card fits the page outline */
	headingLevel?: "h2" | "h3";
	priority?: boolean;
	/** Prefix the label with a type, e.g. "Recipe" in mixed grids. */
	typeLabel?: string;
	/** Photo beside text when wide (seasonal mosaic). */
	adaptive?: boolean;
}

const { recipe, headingLevel = "h3", priority = false, typeLabel, adaptive = false } = Astro.props;
const d = recipe.data;
const eyebrow = [typeLabel, ...(d.terms?.course ?? []).map((c) => c.label)].filter(Boolean).join(" · ");
const time = formatMinutes(totalMinutes(d.prep_minutes, d.cook_minutes, d.extra_minutes));
---

<ContentTile
	class="recipe-tile"
	href={`/recipes/${recipe.id}`}
	image={d.hero_image}
	eyebrow={eyebrow}
	title={d.title}
	summary={d.summary}
	meta={time}
	headingLevel={headingLevel}
	priority={priority}
	adaptive={adaptive}
	imageSlot={adaptive ? SLOTS.mosaicRecipe : SLOTS.recipeTile}
/>
