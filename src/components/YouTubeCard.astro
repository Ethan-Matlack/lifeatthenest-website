---
/**
 * Compact card that links out to a YouTube video: thumbnail with a play
 * badge, plus the video title and channel. No player loads on our page.
 *
 * Title/channel come from YouTube's public oEmbed endpoint (no API key),
 * cached at Cloudflare's edge for a day. If that lookup fails or is slow,
 * the card still renders with a generic title.
 */
import { getYouTubeStart } from "../utils/youtube";

interface Props {
	videoId: string;
	/** Original URL, used for the start time */
	url?: string;
	title?: string | null;
	caption?: string | null;
}

const { videoId, url, title: givenTitle, caption } = Astro.props;
const start = getYouTubeStart(url);
const watchUrl = `https://www.youtube.com/watch?v=${videoId}${start ? `&t=${start}s` : ""}`;

let title = givenTitle?.trim() || "";
let channel = "";
try {
	const res = await fetch(
		`https://www.youtube.com/oembed?format=json&url=${encodeURIComponent(`https://www.youtube.com/watch?v=${videoId}`)}`,
		{
			signal: AbortSignal.timeout(1500),
			// Cloudflare Workers: cache the lookup at the edge for a day.
			cf: { cacheTtl: 86400, cacheEverything: true },
		} as RequestInit,
	);
	if (res.ok) {
		const data = (await res.json()) as { title?: string; author_name?: string };
		title ||= data.title?.trim() ?? "";
		channel = data.author_name?.trim() ?? "";
	}
} catch {
	// Offline, slow, or removed video: fall back to the generic text below.
}
title ||= "Watch this video on YouTube";
---

<figure class="yt-card">
	<a class="yt-link" href={watchUrl} target="_blank" rel="noopener">
		<span class="yt-thumb">
			<img
				src={`https://i.ytimg.com/vi/${videoId}/mqdefault.jpg`}
				alt=""
				width="320"
				height="180"
				loading="lazy"
				decoding="async"
			/>
			<span class="yt-play" aria-hidden="true">
				<svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5.5v13l11-6.5z" /></svg>
			</span>
		</span>
		<span class="yt-body">
			<span class="yt-source">
				<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
					<path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.5 15.6V8.4l6.3 3.6z" />
				</svg>
				Video
			</span>
			<span class="yt-title">{title}</span>
			{channel && <span class="yt-channel">{channel}</span>}
			<span class="yt-cta">
				Watch on YouTube
				<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
					<path d="M7 17 17 7M9 7h8v8" />
				</svg>
				<span class="visually-hidden">(opens in a new tab)</span>
			</span>
		</span>
	</a>
	{caption && <figcaption class="yt-caption">{caption}</figcaption>}
</figure>

<style>
	.yt-card {
		margin: var(--space-xl) 0;
	}

	.yt-link {
		display: grid;
		grid-template-columns: minmax(7.5rem, 38%) 1fr;
		align-items: stretch;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		color: inherit;
		text-decoration: none;
		box-shadow: var(--shadow-sm);
		transition:
			box-shadow 0.2s ease,
			transform 0.2s ease,
			border-color 0.2s ease;
	}

	.yt-link:hover {
		color: inherit;
		border-color: var(--color-sage);
		box-shadow: var(--shadow-md);
		transform: translateY(-2px);
	}

	/* Thumbnail fills its column at whatever height the text needs. */
	.yt-thumb {
		position: relative;
		display: block;
		min-width: 0;
		min-height: 6rem;
		background: #000;
	}

	@media (min-width: 40rem) {
		.yt-thumb {
			min-height: 9rem;
		}
	}

	.yt-thumb img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.yt-play {
		position: absolute;
		top: 50%;
		left: 50%;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		background: rgb(255 255 255 / 0.92);
		color: #c4302b;
		box-shadow: 0 2px 10px rgb(0 0 0 / 0.25);
		transform: translate(-50%, -50%);
		transition: transform 0.2s ease;
	}

	.yt-play svg {
		fill: currentColor;
		margin-left: 2px;
	}

	.yt-link:hover .yt-play {
		transform: translate(-50%, -50%) scale(1.1);
	}

	.yt-body {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.2rem;
		min-width: 0;
		padding: var(--space-xs) var(--space-sm);
	}

	.yt-source {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #c4302b;
	}

	.yt-source svg {
		fill: currentColor;
	}

	.yt-title {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		font-family: var(--font-display);
		font-size: clamp(1rem, 0.92rem + 0.4vw, 1.25rem);
		line-height: var(--leading-snug);
		color: var(--color-heading);
	}

	.yt-channel {
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		font-size: var(--text-sm);
		color: var(--color-muted);
	}

	.yt-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		margin-top: 0.15rem;
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--color-link);
	}

	.yt-cta svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.yt-link:hover .yt-cta {
		text-decoration: underline;
	}

	/* Very narrow phones: drop the CTA line; the whole card is the link. */
	@media (max-width: 22rem) {
		.yt-cta {
			display: none;
		}
	}

	.yt-caption {
		margin-top: var(--space-2xs);
		font-size: var(--text-sm);
		color: var(--color-muted);
	}
</style>
