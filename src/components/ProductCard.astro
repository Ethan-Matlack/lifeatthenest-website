---
/** Affiliate product card (one link to the store). Used in "Shop this post/recipe" and on the Shop page. */
import { Image } from "emdash/ui";
import { SLOTS, slotProps } from "../utils/image-slots";
import type { ContentEntry } from "emdash";
import type { Product } from "../../emdash-env";

interface Props {
	product: ContentEntry<Product>;
	headingLevel?: "h2" | "h3" | "h4";
}

const { product, headingLevel = "h3" } = Astro.props;
const d = product.data;
const Heading = headingLevel;
const store = d.store?.trim() || "the store";
---

<article class="product-card">
	<a class="product-link" href={d.link} target="_blank" rel="sponsored noopener">
		<div class="product-media">
			{
				d.image ? (
					<Image image={d.image} alt="" {...slotProps(d.image, SLOTS.product)} />
				) : (
					<div class="photo-placeholder" aria-hidden="true" />
				)
			}
		</div>
		<div class="product-body">
			<Heading class="product-title">{d.title}</Heading>
			{d.blurb && <p class="product-blurb">{d.blurb}</p>}
			<span class="btn product-btn">
				Shop on {store}
				<span class="visually-hidden">(opens in a new tab)</span>
			</span>
		</div>
	</a>
</article>

<style>
	/* The whole card is one link, like the recipe/post/seasonal tiles, with
	   the same hover lift. "Shop on …" is styled as a button inside it. */
	.product-card {
		height: 100%;
	}

	.product-link {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		color: inherit;
		text-decoration: none;
		transition:
			box-shadow 0.2s ease,
			transform 0.2s ease;
	}

	.product-link:hover {
		box-shadow: var(--shadow-md);
		transform: translateY(-2px);
		color: inherit;
	}

	.product-link:hover .product-title {
		color: var(--color-moss);
	}

	.product-link:hover .product-btn {
		background: var(--color-moss);
		border-color: var(--color-moss);
	}

	.product-media {
		display: block;
		aspect-ratio: 1;
		overflow: hidden;
		background: var(--color-surface);
	}

	/* Fill the square and crop, like the other cards. */
	.product-media :global(img),
	.product-media .photo-placeholder {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.product-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: var(--space-2xs);
		padding: var(--space-sm);
	}

	.product-title {
		margin: 0;
		font-size: var(--text-lg);
		line-height: var(--leading-snug);
	}

	.product-blurb {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--color-muted);
	}

	/* Full-width on narrow cards so "Shop on Amazon" never wraps. */
	.product-btn {
		margin-top: auto;
		align-self: stretch;
		min-height: 2.5rem;
		padding: 0.4rem 0.6rem;
		font-size: var(--text-xs);
		white-space: nowrap;
	}

	@media (min-width: 48rem) {
		.product-btn {
			align-self: flex-start;
			padding: 0.4rem 1.1rem;
			font-size: var(--text-sm);
		}
	}
</style>
