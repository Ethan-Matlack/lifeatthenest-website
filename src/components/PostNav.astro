---
/**
 * Previous / next links at the end of an article, in publish order.
 * "Previous" is the older neighbor, "Next" the newer one. On the oldest or
 * newest post the missing side shows an "end of the line" card linking to
 * the full list, so the row stays balanced.
 */
import { Image } from "emdash/ui";

interface NavEntry {
	href: string;
	title: string;
	image?: Parameters<typeof Image>[0]["image"] | null;
}

interface Props {
	previous?: NavEntry | null;
	next?: NavEntry | null;
	label?: string;
	/** Where the end card points, and what it calls the list. */
	allHref?: string;
	allLabel?: string;
}

const { previous, next, label = "More posts", allHref = "/posts", allLabel = "Browse all posts" } = Astro.props;
---

{
	(previous || next) && (
		<nav class="post-nav" aria-label={label}>
			{previous ? (
				<a class="post-nav-link post-nav-link--prev" href={previous.href} rel="prev">
					{previous.image ? (
						<Image image={previous.image} alt="" class="post-nav-thumb" sizes="5rem" />
					) : (
						<span class="post-nav-thumb photo-placeholder" aria-hidden="true" />
					)}
					<span class="post-nav-text">
						<span class="post-nav-dir">
							<span aria-hidden="true">&larr;</span> Previous
						</span>
						<span class="post-nav-title">{previous.title}</span>
					</span>
				</a>
			) : (
				<a class="post-nav-link post-nav-end" href={allHref}>
					<span class="post-nav-thumb post-nav-end-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="26" height="26">
							<path d="M12 21v-9M12 12c0-3.5-2.5-6-6.5-6 0 3.5 2.5 6 6.5 6ZM12 15c0-3 2.2-5.5 6-5.5 0 3-2.2 5.5-6 5.5Z" />
						</svg>
					</span>
					<span class="post-nav-text">
						<span class="post-nav-dir">The beginning</span>
						<span class="post-nav-title">You've reached the very first post</span>
						<span class="post-nav-more">{allLabel}</span>
					</span>
				</a>
			)}
			{next ? (
				<a class="post-nav-link post-nav-link--next" href={next.href} rel="next">
					<span class="post-nav-text">
						<span class="post-nav-dir">
							Next <span aria-hidden="true">&rarr;</span>
						</span>
						<span class="post-nav-title">{next.title}</span>
					</span>
					{next.image ? (
						<Image image={next.image} alt="" class="post-nav-thumb" sizes="5rem" />
					) : (
						<span class="post-nav-thumb photo-placeholder" aria-hidden="true" />
					)}
				</a>
			) : (
				<a class="post-nav-link post-nav-link--next post-nav-end" href={allHref}>
					<span class="post-nav-text">
						<span class="post-nav-dir">All caught up</span>
						<span class="post-nav-title">This is the newest post</span>
						<span class="post-nav-more">{allLabel}</span>
					</span>
					<span class="post-nav-thumb post-nav-end-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="26" height="26">
							<path d="M5 12.5 10 17.5 19 7.5" />
						</svg>
					</span>
				</a>
			)}
		</nav>
	)
}

<style>
	.post-nav {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-sm);
	}

	@media (min-width: 40rem) {
		.post-nav {
			grid-template-columns: 1fr 1fr;
		}
	}

	.post-nav-link {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		height: 100%;
		padding: var(--space-sm);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			box-shadow 0.2s ease;
	}

	.post-nav-link:hover {
		border-color: var(--color-sage);
		box-shadow: var(--shadow-md);
		color: inherit;
	}

	.post-nav-link--next {
		justify-content: flex-end;
		text-align: right;
	}

	.post-nav-thumb,
	.post-nav-link :global(.post-nav-thumb) {
		flex: none;
		width: 4.5rem;
		height: 4.5rem;
		border-radius: var(--radius-md);
		object-fit: cover;
	}

	.post-nav-text {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
	}

	.post-nav-dir {
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-moss);
	}

	.post-nav-title {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		font-family: var(--font-display);
		font-size: var(--text-lg);
		line-height: var(--leading-snug);
		color: var(--color-heading);
	}

	.post-nav-link:hover .post-nav-title {
		color: var(--color-moss);
	}

	/* "End of the line" card: a quieter sibling of the real links. */
	.post-nav-end {
		border-style: dashed;
		background: var(--color-surface-alt);
	}

	.post-nav-end-icon {
		display: grid;
		place-items: center;
		background: var(--color-surface);
		color: var(--color-moss);
	}

	.post-nav-end-icon svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.post-nav-more {
		margin-top: 0.1rem;
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--color-link);
	}

	.post-nav-end:hover .post-nav-more {
		text-decoration: underline;
	}
</style>
