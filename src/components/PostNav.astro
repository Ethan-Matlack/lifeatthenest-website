---
/**
 * Previous / next links at the end of an article, in publish order.
 * "Previous" is the older neighbor, "Next" the newer one.
 */
import { Image } from "emdash/ui";

interface NavEntry {
	href: string;
	title: string;
	image?: Parameters<typeof Image>[0]["image"] | null;
}

interface Props {
	previous?: NavEntry | null;
	next?: NavEntry | null;
	label?: string;
}

const { previous, next, label = "More posts" } = Astro.props;
---

{
	(previous || next) && (
		<nav class="post-nav" aria-label={label}>
			{previous ? (
				<a class="post-nav-link post-nav-link--prev" href={previous.href} rel="prev">
					{previous.image ? (
						<Image image={previous.image} alt="" class="post-nav-thumb" sizes="5rem" />
					) : (
						<span class="post-nav-thumb photo-placeholder" aria-hidden="true" />
					)}
					<span class="post-nav-text">
						<span class="post-nav-dir">
							<span aria-hidden="true">&larr;</span> Previous
						</span>
						<span class="post-nav-title">{previous.title}</span>
					</span>
				</a>
			) : (
				<span class="post-nav-spacer" />
			)}
			{next ? (
				<a class="post-nav-link post-nav-link--next" href={next.href} rel="next">
					<span class="post-nav-text">
						<span class="post-nav-dir">
							Next <span aria-hidden="true">&rarr;</span>
						</span>
						<span class="post-nav-title">{next.title}</span>
					</span>
					{next.image ? (
						<Image image={next.image} alt="" class="post-nav-thumb" sizes="5rem" />
					) : (
						<span class="post-nav-thumb photo-placeholder" aria-hidden="true" />
					)}
				</a>
			) : (
				<span class="post-nav-spacer" />
			)}
		</nav>
	)
}

<style>
	.post-nav {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-sm);
	}

	@media (min-width: 40rem) {
		.post-nav {
			grid-template-columns: 1fr 1fr;
		}
	}

	.post-nav-link {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		height: 100%;
		padding: var(--space-sm);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			box-shadow 0.2s ease;
	}

	.post-nav-link:hover {
		border-color: var(--color-sage);
		box-shadow: var(--shadow-md);
		color: inherit;
	}

	.post-nav-link--next {
		justify-content: flex-end;
		text-align: right;
	}

	.post-nav-thumb,
	.post-nav-link :global(.post-nav-thumb) {
		flex: none;
		width: 4.5rem;
		height: 4.5rem;
		border-radius: var(--radius-md);
		object-fit: cover;
	}

	.post-nav-text {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
	}

	.post-nav-dir {
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-moss);
	}

	.post-nav-title {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		font-family: var(--font-display);
		font-size: var(--text-lg);
		line-height: var(--leading-snug);
		color: var(--color-heading);
	}

	.post-nav-link:hover .post-nav-title {
		color: var(--color-moss);
	}

	/* Hide the empty side on phones so a lone link isn't preceded by a gap. */
	.post-nav-spacer {
		display: none;
	}

	@media (min-width: 40rem) {
		.post-nav-spacer {
			display: block;
		}
	}
</style>
