---
/**
 * Blog post tile, matching RecipeTile (both use ContentTile): the whole
 * tile is one link. Used on the blog, the homepage, and seasonal pages.
 * Categories show as plain text (a link inside a link isn't allowed); the
 * blog's category chips handle filtering.
 */
import type { ContentEntry } from "emdash";
import type { Post } from "../../emdash-env";
import ContentTile from "./ContentTile.astro";
import { SLOTS } from "../utils/image-slots";
import { formatDate } from "../utils/format";
import { readingMinutes } from "../utils/portable-text";

interface Props {
	post: ContentEntry<Post>;
	headingLevel?: "h2" | "h3";
	priority?: boolean;
	/** Prefix the label with a type, e.g. "Story" in mixed grids. */
	typeLabel?: string;
	/** Photo beside text when wide (seasonal mosaic). */
	adaptive?: boolean;
}

const { post, headingLevel = "h3", priority = false, typeLabel, adaptive = false } = Astro.props;
const d = post.data;
const eyebrow = [typeLabel, ...(d.terms?.category ?? []).map((c) => c.label)].filter(Boolean).join(" · ");
const minutes = readingMinutes(d.content);
const meta = [d.publishedAt ? formatDate(d.publishedAt) : null, minutes ? `${minutes} min read` : null]
	.filter(Boolean)
	.join(" · ");
---

<ContentTile
	class="post-tile"
	href={`/posts/${post.id}`}
	image={d.featured_image}
	eyebrow={eyebrow}
	title={d.title}
	summary={d.excerpt}
	meta={meta}
	headingLevel={headingLevel}
	priority={priority}
	adaptive={adaptive}
	imageSlot={adaptive ? SLOTS.mosaicPost : SLOTS.postTile}
/>
