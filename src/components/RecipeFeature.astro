---
/**
 * Compact "Get the recipe" card linking a blog post to a recipe.
 * Used inline in post bodies (a recipe link on its own line) and for
 * recipes picked in a post's "Recipes in this post" field.
 */
import { Image } from "emdash/ui";
import type { ContentEntry } from "emdash";
import type { Recipe } from "../../emdash-env";

interface Props {
	// eslint-disable-next-line @typescript-eslint/no-explicit-any
	recipe: ContentEntry<Recipe, any>;
}

const { recipe } = Astro.props;
const d = recipe.data;
const href = `/recipes/${recipe.id}`;
---

<article class="recipe-feature">
	<a class="rf-media" href={href} tabindex="-1" aria-hidden="true">
		{
			d.hero_image ? (
				<Image image={d.hero_image} alt="" sizes="(min-width: 40rem) 11rem, 32vw" />
			) : (
				<div class="photo-placeholder" />
			)
		}
	</a>
	<div class="rf-body">
		<span class="rf-label">Recipe</span>
		<h3 class="rf-title"><a href={href}>{d.title}</a></h3>
		{d.summary && <p class="rf-summary">{d.summary}</p>}
		<a class="rf-cta" href={href}>
			Get the recipe <span aria-hidden="true">&rarr;</span>
			<span class="visually-hidden">: {d.title}</span>
		</a>
	</div>
</article>

<style>
	/* Note: also rendered inside .prose rich text, so reset prose spacing. */
	.recipe-feature {
		display: grid;
		grid-template-columns: minmax(6rem, 30%) 1fr;
		max-width: 34rem;
		margin: var(--space-lg) 0;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-left: 4px solid var(--color-sage);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		box-shadow: var(--shadow-sm);
		font-size: var(--text-base);
		transition:
			box-shadow 0.2s ease,
			border-color 0.2s ease;
	}

	.recipe-feature:hover {
		box-shadow: var(--shadow-md);
	}

	.rf-media {
		position: relative;
		display: block;
		min-height: 6.5rem;
	}

	.rf-media :global(img),
	.rf-media .photo-placeholder {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		margin: 0;
		border-radius: 0;
		object-fit: cover;
	}

	.rf-body {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.15rem;
		min-width: 0;
		padding: var(--space-xs) var(--space-sm);
	}

	.rf-label {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-moss);
	}

	.rf-title {
		margin: 0;
		font-size: var(--text-lg);
		line-height: var(--leading-snug);
	}

	.rf-title a {
		color: var(--color-heading);
		text-decoration: none;
	}

	.rf-title a:hover {
		color: var(--color-moss);
		text-decoration: underline;
		text-decoration-thickness: 1px;
	}

	.rf-summary {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		margin: 0;
		font-size: var(--text-sm);
		line-height: 1.45;
		color: var(--color-muted);
	}

	.rf-cta {
		margin-top: 0.3rem;
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--color-link);
		text-decoration: none;
	}

	.rf-cta:hover {
		text-decoration: underline;
	}
</style>
