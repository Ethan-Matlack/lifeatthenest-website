---
/** Portable Text `embed` block: YouTube/TikTok/Instagram/Facebook get the video card, others use EmDash's default. */
import { Embed } from "emdash/ui";
import VideoCard from "../VideoCard.astro";
import { parseVideoLink } from "../../utils/video";

const { node } = Astro.props as { node: { url?: string; caption?: string; title?: string } };
const isVideo = Boolean(parseVideoLink(node?.url));
---

{
	isVideo ? (
		<VideoCard url={node.url!} title={node.title} caption={node.caption} />
	) : (
		<Embed {...(Astro.props as any)} />
	)
}
