---
/** Portable Text `iframe` block: YouTube/TikTok/Instagram/Facebook get the video card, others use EmDash's default. */
import { Iframe } from "emdash/ui";
import VideoCard from "../VideoCard.astro";
import { parseVideoLink } from "../../utils/video";

const { node } = Astro.props as { node: { src?: string; title?: string } };
const isVideo = Boolean(parseVideoLink(node?.src));
---

{
	isVideo ? (
		<VideoCard url={node.src!} title={node.title} />
	) : (
		<Iframe {...(Astro.props as any)} />
	)
}
