---
/** Portable Text `iframe` block: YouTube gets the video card, others use EmDash's default. */
import { Iframe } from "emdash/ui";
import YouTubeCard from "../YouTubeCard.astro";
import { getYouTubeId } from "../../utils/youtube";

const { node } = Astro.props as { node: { src?: string; title?: string } };
const videoId = getYouTubeId(node?.src);
---

{
	videoId ? (
		<YouTubeCard videoId={videoId} url={node.src} title={node.title} />
	) : (
		<Iframe {...(Astro.props as any)} />
	)
}
