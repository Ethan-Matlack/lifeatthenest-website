---
/**
 * The bordered photo tile shared by RecipeTile and PostTile, so recipes and
 * blog posts look the same when mixed in one grid (seasonal pages).
 * Presentational only: callers supply the link, image, and text.
 */
import { Image } from "emdash/ui";
import { SLOTS, slotProps, type Slot } from "../utils/image-slots";

type ImageValue = Parameters<typeof Image>[0]["image"];

interface Props {
	href: string;
	image?: ImageValue | null;
	eyebrow?: string;
	title: string;
	summary?: string | null;
	/** Bottom line, e.g. cooking time or reading time. */
	meta?: string | null;
	/** Heading level for the title, so the card fits the page outline */
	headingLevel?: "h2" | "h3";
	priority?: boolean;
	/** Extra class on the root, e.g. "recipe-tile". */
	class?: string;
	/** Switch to photo-beside-text when the tile is at least ~30rem wide
	 *  (used by the seasonal mosaic; off elsewhere). */
	adaptive?: boolean;
	/** Image shape, size, and `sizes` for where the tile sits (src/utils/image-slots.ts). */
	imageSlot?: Slot;
}

const {
	href,
	image,
	eyebrow,
	title,
	summary,
	meta,
	headingLevel = "h3",
	priority = false,
	class: className,
	adaptive = false,
	imageSlot = SLOTS.postTile,
} = Astro.props;
const Heading = headingLevel;
---

<article class:list={["content-tile", className, { "content-tile--adaptive": adaptive }]}>
	<a class="tile-link" href={href}>
		<div class="tile-media">
			{
				image ? (
					<Image image={image} alt="" {...slotProps(image, imageSlot)} priority={priority} />
				) : (
					<div class="photo-placeholder" aria-hidden="true" />
				)
			}
		</div>
		<div class="tile-body">
			{eyebrow && <span class="eyebrow">{eyebrow}</span>}
			<Heading class="tile-title">{title}</Heading>
			{summary && <p class="tile-summary">{summary}</p>}
			{meta && <p class="tile-meta">{meta}</p>}
		</div>
	</a>
</article>

<style>
	.content-tile {
		height: 100%;
		container-type: inline-size;
	}

	.tile-link {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		color: inherit;
		text-decoration: none;
		transition:
			box-shadow 0.2s ease,
			transform 0.2s ease;
	}

	.tile-link:hover {
		box-shadow: var(--shadow-md);
		transform: translateY(-2px);
		color: inherit;
	}

	.tile-media {
		aspect-ratio: 4 / 3;
		overflow: hidden;
	}

	.tile-media :global(img),
	.tile-media .photo-placeholder {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.tile-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		align-items: flex-start;
		padding: var(--space-xs) var(--space-sm) var(--space-sm);
	}

	@media (min-width: 40rem) {
		.tile-body {
			padding: var(--space-sm) var(--space-md) var(--space-md);
		}
	}

	.tile-body .eyebrow {
		margin-bottom: var(--space-3xs);
	}

	.tile-title {
		margin: 0;
		font-size: clamp(1.05rem, 0.9rem + 0.8vw, 1.6rem);
		line-height: var(--leading-snug);
	}

	.tile-link:hover .tile-title {
		color: var(--color-moss);
	}

	/* Short description, shown in full: the field is capped at 160
	   characters, so it's at most ~5 lines in a normal tile, and tiles in a
	   row share a height anyway. Only the narrow two-up tiles on phones
	   (where 160 characters would be ~9 lines) cut it off, after 3 lines. */
	.tile-summary {
		margin: var(--space-2xs) 0 0;
		color: var(--color-muted);
	}

	@container (max-width: 14rem) {
		.tile-summary {
			display: -webkit-box;
			-webkit-line-clamp: 3;
			line-clamp: 3;
			-webkit-box-orient: vertical;
			overflow: hidden;
			font-size: var(--text-sm);
		}
	}

	/* Adaptive tiles (seasonal mosaic): photo beside the text once the tile is
	   wide enough, so a wide story card reads like a feature, not a tall
	   column. The photo fills its half at whatever height the row has. */
	@container (min-width: 30rem) {
		.content-tile--adaptive .tile-link {
			flex-direction: row;
		}

		.content-tile--adaptive .tile-media {
			position: relative;
			flex: 0 0 45%;
			aspect-ratio: auto;
			min-height: 14rem;
		}

		.content-tile--adaptive .tile-media :global(img),
		.content-tile--adaptive .tile-media .photo-placeholder {
			position: absolute;
			inset: 0;
		}

		.content-tile--adaptive .tile-body {
			justify-content: center;
			padding: var(--space-md) var(--space-lg);
		}
	}

	/* Pinned to the bottom so the meta lines up across a row. */
	.tile-meta {
		margin: auto 0 0;
		padding-top: var(--space-2xs);
		font-size: var(--text-sm);
		color: var(--color-muted);
	}
</style>
