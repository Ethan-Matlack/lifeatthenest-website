---
/**
 * The printable recipe card: yield + times, scaling controls, ingredients
 * and steps with checkboxes, equipment, notes, video, and credit.
 *
 * - Server renders base amounts (already formatted as kitchen fractions),
 *   so the card is complete without JS.
 * - JS adds: ½×/1×/2×/3× and a servings stepper (rescales amounts and unit
 *   plurals), remembers checkmarks + servings per recipe, and Print/PDF.
 * - Print styles live on the recipe page so only this card prints.
 */
import { Image } from "emdash/ui";
import type { ContentEntry } from "emdash";
import type { Recipe } from "../../emdash-env";
import RichText from "./RichText.astro";
import VideoCard from "./VideoCard.astro";
import { formatMinutes, totalMinutes } from "../utils/format";
import { formatNumber, scaleAmount, scaledMax, unitLabel } from "../utils/amount";
import { parseVideoLink } from "../utils/video";

interface Props {
	// Any loaded references are ignored here, so accept whatever was requested.
	// eslint-disable-next-line @typescript-eslint/no-explicit-any
	recipe: ContentEntry<Recipe, any>;
}

const { recipe } = Astro.props;
const d = recipe.data;
const base = d.servings && d.servings > 0 ? d.servings : 1;
const yieldUnit = d.yield_unit?.trim() || "servings";

/** Split rows into sections; a heading carries forward until it changes. */
function groupRows<T extends { group?: string | null }>(rows: T[] | null | undefined) {
	const groups: { heading: string; items: { row: T; index: number }[] }[] = [];
	let current = "";
	(rows ?? []).forEach((row, index) => {
		const heading = row.group?.trim() || current;
		if (!groups.length || heading !== current) groups.push({ heading, items: [] });
		current = heading;
		groups[groups.length - 1]!.items.push({ row, index });
	});
	return groups;
}

const ingredientGroups = groupRows(d.ingredients);
const stepGroups = groupRows(d.steps);

const times = [
	{ label: "Prep", minutes: d.prep_minutes },
	{ label: "Cook", minutes: d.cook_minutes },
	{ label: "Extra", minutes: d.extra_minutes },
].filter((t) => t.minutes && t.minutes > 0);
const total = totalMinutes(d.prep_minutes, d.cook_minutes, d.extra_minutes);

const equipment = (d.equipment ?? "")
	.split("\n")
	.map((s) => s.trim())
	.filter(Boolean);
const hasVideoCard = Boolean(parseVideoLink(d.video_url));
const hasNotes = Array.isArray(d.notes) && d.notes.length > 0;
const multipliers = [
	{ factor: 0.5, label: "½×" },
	{ factor: 1, label: "1×" },
	{ factor: 2, label: "2×" },
	{ factor: 3, label: "3×" },
];
---

<section
	class="recipe-card"
	id="recipe"
	aria-labelledby="recipe-card-title"
	data-recipe-card
	data-base={base}
	data-storage-key={`recipe:${recipe.id}`}
>
	<header class="rc-head">
		<div class="rc-titles">
			<span class="eyebrow">Recipe</span>
			<h2 id="recipe-card-title">{d.title}</h2>
			{d.summary && <p class="rc-summary">{d.summary}</p>}
		</div>
		<button type="button" class="btn rc-print no-print" data-print hidden>
			<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
				<path d="M6 9V3h12v6M6 18H4a1 1 0 0 1-1-1v-6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v6a1 1 0 0 1-1 1h-2M6 14h12v7H6z" />
			</svg>
			Print / Save PDF
		</button>
		<img
			class="rc-print-logo"
			src="/images/logo.svg"
			alt=""
			aria-hidden="true"
			width="341"
			height="90"
			loading="eager"
			decoding="sync"
		/>
	</header>

	<dl class="rc-meta">
		{
			times.map((t) => (
				<div>
					<dt>{t.label}</dt>
					<dd>{formatMinutes(t.minutes!)}</dd>
				</div>
			))
		}
		{
			total > 0 && times.length > 1 && (
				<div>
					<dt>Total</dt>
					<dd>{formatMinutes(total)}</dd>
				</div>
			)
		}
		<div>
			<dt>Makes</dt>
			<dd>
				<span data-yield>{formatNumber(base)}</span>{" "}{yieldUnit}
			</dd>
		</div>
		{
			d.difficulty && (
				<div>
					<dt>Difficulty</dt>
					<dd>{d.difficulty}</dd>
				</div>
			)
		}
	</dl>

	<div class="rc-scale no-print" data-scale hidden>
		<div class="rc-stepper">
			<span class="rc-scale-label" id="rc-servings-label">Makes</span>
			<button type="button" class="rc-step-btn" data-step="-1" aria-label={`Fewer ${yieldUnit}`}>−</button>
			<output class="rc-servings" aria-labelledby="rc-servings-label" aria-live="polite" data-servings>
				{formatNumber(base)}
			</output>
			<button type="button" class="rc-step-btn" data-step="1" aria-label={`More ${yieldUnit}`}>+</button>
			<span class="rc-scale-unit">{yieldUnit}</span>
		</div>
		<div class="rc-multipliers" role="group" aria-label="Scale recipe">
			{
				multipliers.map((m) => (
					<button
						type="button"
						class="rc-mult"
						data-factor={m.factor}
						aria-pressed={m.factor === 1 ? "true" : "false"}
					>
						{m.label}
					</button>
				))
			}
		</div>
	</div>

	<div class="rc-body">
		<div class="rc-ingredients">
			<h3>Ingredients</h3>
			{
				ingredientGroups.map((g) => (
					<div class="rc-group">
						{g.heading && <h4>{g.heading}</h4>}
						<ul>
							{g.items.map(({ row, index }) => {
								const amount = scaleAmount(row.amount, 1, Boolean(row.fixed));
								const unit = unitLabel(row.unit, scaledMax(row.amount, 1, Boolean(row.fixed)));
								return (
									<li
										class="rc-ing"
										data-index={index}
										data-amount={row.amount ?? ""}
										data-unit={row.unit ?? ""}
										data-fixed={row.fixed ? "1" : undefined}
									>
										<label>
											<input type="checkbox" class="rc-check" />
											<span class="rc-text">
												{amount && <><strong class="rc-amt">{amount}</strong>{" "}</>}
												{unit && <><span class="rc-unit">{unit}</span>{" "}</>}
												<span class="rc-item">{row.item}</span>
												{row.note && <span class="rc-note">, {row.note}</span>}
											</span>
										</label>
									</li>
								);
							})}
						</ul>
					</div>
				))
			}
		</div>

		<div class="rc-steps">
			<h3>Instructions</h3>
			{
				stepGroups.map((g) => (
					<div class="rc-group">
						{g.heading && <h4>{g.heading}</h4>}
						<ol start={g.items[0]!.index + 1}>
							{g.items.map(({ row, index }) => (
								<li class="rc-step" id={`step-${index + 1}`} data-index={index}>
									<label>
										<input type="checkbox" class="rc-check" aria-label={`Step ${index + 1} done`} />
										<span class="rc-text"><span class="rc-num" aria-hidden="true">{index + 1}.</span> {row.instruction?.trim()}</span>
									</label>
									{row.image && (
										<Image image={row.image} class="rc-step-img no-print" sizes="(min-width: 48rem) 30rem, 90vw" />
									)}
								</li>
							))}
						</ol>
					</div>
				))
			}
		</div>
	</div>

	{
		equipment.length > 0 && (
			<div class="rc-extra">
				<h3>Equipment</h3>
				<ul class="rc-equipment">
					{equipment.map((e) => (
						<li>{e}</li>
					))}
				</ul>
			</div>
		)
	}

	{
		hasNotes && (
			<div class="rc-extra rc-notes">
				<h3>Tips, Substitutions &amp; Storage</h3>
				<RichText value={d.notes} {...recipe.edit.notes} />
			</div>
		)
	}

	{
		d.video_url && (
			<div class="rc-extra no-print">
				<h3>Watch</h3>
				{hasVideoCard ? (
					<VideoCard url={d.video_url!} />
				) : (
					<p>
						<a href={d.video_url} target="_blank" rel="noopener">
							Watch the video
						</a>
					</p>
				)}
			</div>
		)
	}

	<footer class="rc-foot">
		{d.calories && <p>About {d.calories} calories per serving.</p>}
		{d.credit && <p class="rc-credit">{d.credit}</p>}
		<button type="button" class="rc-reset no-print" data-reset hidden>Clear checkmarks</button>
	</footer>
</section>

<script>
	import { formatNumber, scaleAmount, scaledMax, unitLabel } from "../utils/amount";

	interface Saved {
		servings?: number;
		ing?: number[];
		step?: number[];
	}

	for (const card of document.querySelectorAll<HTMLElement>("[data-recipe-card]")) {
		const base = Number(card.dataset.base) || 1;
		const key = card.dataset.storageKey ?? "";
		const ingredients = Array.from(card.querySelectorAll<HTMLElement>(".rc-ing"));
		const steps = Array.from(card.querySelectorAll<HTMLElement>(".rc-step"));
		const servingsOut = card.querySelector<HTMLElement>("[data-servings]");
		const yieldOut = card.querySelector<HTMLElement>("[data-yield]");
		const multButtons = Array.from(card.querySelectorAll<HTMLButtonElement>(".rc-mult"));
		const resetBtn = card.querySelector<HTMLButtonElement>("[data-reset]");

		// localStorage can throw (private mode, blocked storage): never let that break the card.
		const load = (): Saved => {
			try {
				return JSON.parse(localStorage.getItem(key) ?? "{}") as Saved;
			} catch {
				return {};
			}
		};
		const save = (data: Saved) => {
			try {
				localStorage.setItem(key, JSON.stringify(data));
			} catch {
				/* ignore */
			}
		};

		let servings = base;

		const checkedIndexes = (rows: HTMLElement[]) =>
			rows.filter((r) => r.querySelector<HTMLInputElement>(".rc-check")?.checked).map((r) => Number(r.dataset.index));

		const persist = () =>
			save({
				servings: servings === base ? undefined : servings,
				ing: checkedIndexes(ingredients),
				step: checkedIndexes(steps),
			});

		const syncReset = () => {
			if (resetBtn) resetBtn.hidden = checkedIndexes(ingredients).length + checkedIndexes(steps).length === 0;
		};

		const render = () => {
			const factor = servings / base;
			for (const li of ingredients) {
				const raw = li.dataset.amount ?? "";
				const fixed = li.dataset.fixed === "1";
				const amt = li.querySelector(".rc-amt");
				const unit = li.querySelector(".rc-unit");
				if (amt) amt.textContent = scaleAmount(raw, factor, fixed);
				if (unit) unit.textContent = unitLabel(li.dataset.unit, scaledMax(raw, factor, fixed));
			}
			const shown = formatNumber(servings);
			if (servingsOut) servingsOut.textContent = shown;
			if (yieldOut) yieldOut.textContent = shown;
			for (const b of multButtons) {
				b.setAttribute("aria-pressed", String(Math.abs(Number(b.dataset.factor) * base - servings) < 1e-9));
			}
		};

		// Restore saved state.
		const saved = load();
		if (saved.servings && saved.servings > 0 && saved.servings < 10000) servings = saved.servings;
		const restore = (rows: HTMLElement[], idx?: number[]) => {
			for (const r of rows) {
				const box = r.querySelector<HTMLInputElement>(".rc-check");
				if (box && idx?.includes(Number(r.dataset.index))) box.checked = true;
			}
		};
		restore(ingredients, saved.ing);
		restore(steps, saved.step);

		// Reveal JS-only controls.
		for (const el of card.querySelectorAll<HTMLElement>("[data-scale], [data-print]")) el.hidden = false;
		render();
		syncReset();

		for (const b of multButtons) {
			b.addEventListener("click", () => {
				servings = Number(b.dataset.factor) * base;
				render();
				persist();
			});
		}

		for (const b of card.querySelectorAll<HTMLButtonElement>("[data-step]")) {
			b.addEventListener("click", () => {
				// Step to the next whole number (2½ → 3 or 2), never below 1.
				servings = Number(b.dataset.step) > 0 ? Math.floor(servings) + 1 : Math.max(1, Math.ceil(servings) - 1);
				render();
				persist();
			});
		}

		card.addEventListener("change", (e) => {
			if (e.target instanceof HTMLInputElement && e.target.classList.contains("rc-check")) {
				persist();
				syncReset();
			}
		});

		resetBtn?.addEventListener("click", () => {
			for (const box of card.querySelectorAll<HTMLInputElement>(".rc-check")) box.checked = false;
			persist();
			syncReset();
		});

		card.querySelector("[data-print]")?.addEventListener("click", () => window.print());
	}
</script>

<style>
	.recipe-card {
		scroll-margin-top: var(--space-md);
		padding: var(--space-lg) var(--space-md);
		border: 1px solid var(--color-border);
		border-top: 6px solid var(--color-sage);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		box-shadow: var(--shadow-md);
	}

	@media (min-width: 48rem) {
		.recipe-card {
			padding: var(--space-xl) var(--space-xl);
		}
	}

	[hidden] {
		display: none !important;
	}

	.rc-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-sm) var(--space-lg);
	}

	.rc-titles {
		flex: 1 1 20rem;
	}

	.rc-head h2 {
		margin-bottom: var(--space-2xs);
		font-size: var(--text-3xl);
	}

	.rc-summary {
		margin: 0;
		color: var(--color-muted);
	}

	/* Logo only appears on the printout, top-right of the card. On screen it's
	   kept loaded but out of sight (not display:none / lazy): iOS Safari prints
	   without fetching images that weren't already loaded. */
	.rc-print-logo {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		pointer-events: none;
	}

	@media print {
		.rc-print-logo {
			position: static;
			clip-path: none;
			overflow: visible;
			pointer-events: auto;
			display: block;
			flex: none;
			width: 1.75in;
			height: auto;
		}
	}

	.rc-print svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linejoin: round;
	}

	/* Meta strip */
	.rc-meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm) var(--space-lg);
		margin: var(--space-lg) 0 0;
		padding: var(--space-sm) 0;
		border-block: 1px solid var(--color-border);
	}

	.rc-meta div {
		min-width: 4.5rem;
	}

	.rc-meta dt {
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-moss);
	}

	.rc-meta dd {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-lg);
		color: var(--color-olive);
	}

	/* Scaling controls */
	.rc-scale {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);
		margin-top: var(--space-md);
		padding: var(--space-sm);
		border-radius: var(--radius-md);
		background: var(--color-linen);
	}

	.rc-stepper {
		display: flex;
		align-items: center;
		gap: var(--space-2xs);
	}

	.rc-scale-label,
	.rc-scale-unit {
		font-weight: 600;
		color: var(--color-olive);
	}

	.rc-step-btn,
	.rc-mult {
		min-width: 2.75rem;
		min-height: 2.75rem;
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius-pill);
		background: var(--color-surface);
		color: var(--color-olive);
		font-weight: 600;
		font-size: var(--text-base);
		cursor: pointer;
	}

	.rc-step-btn {
		font-size: 1.25rem;
		line-height: 1;
	}

	.rc-step-btn:hover,
	.rc-mult:hover {
		border-color: var(--color-moss);
	}

	.rc-servings {
		min-width: 2.5ch;
		font-family: var(--font-display);
		font-size: var(--text-xl);
		text-align: center;
		color: var(--color-olive);
	}

	.rc-multipliers {
		display: flex;
		gap: var(--space-3xs);
	}

	.rc-mult {
		padding: 0 0.8rem;
		font-size: var(--text-sm);
	}

	.rc-mult[aria-pressed="true"] {
		border-color: var(--color-olive);
		background: var(--color-olive);
		color: #fff;
	}

	/* Ingredients + steps */
	.rc-body {
		display: grid;
		gap: var(--space-xl);
		margin-top: var(--space-xl);
	}

	@media (min-width: 56rem) {
		.rc-body {
			grid-template-columns: minmax(16rem, 2fr) 3fr;
			gap: var(--space-2xl);
		}
	}

	.recipe-card h3 {
		margin-bottom: var(--space-sm);
		font-size: var(--text-2xl);
	}

	.recipe-card h4 {
		margin: var(--space-md) 0 var(--space-2xs);
		font-family: var(--font-body);
		font-size: var(--text-sm);
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-moss);
	}

	.rc-group:first-of-type h4 {
		margin-top: 0;
	}

	.rc-ingredients ul,
	.rc-steps ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.rc-ing + .rc-ing {
		border-top: 1px dashed var(--color-border);
	}

	.rc-ing label,
	.rc-step label {
		display: flex;
		gap: var(--space-xs);
		align-items: flex-start;
		padding: 0.55rem 0;
		cursor: pointer;
	}

	.rc-check {
		flex: none;
		width: 1.25rem;
		height: 1.25rem;
		margin: 0.2rem 0 0;
		accent-color: var(--color-olive);
		cursor: pointer;
	}

	.rc-text {
		transition: color 0.15s ease;
	}

	.rc-amt {
		font-weight: 700;
		color: var(--color-olive);
	}

	.rc-unit {
		font-weight: 600;
		color: var(--color-olive);
	}

	.rc-note {
		color: var(--color-muted);
	}

	/* Checked rows fade and strike through. */
	li:has(> label .rc-check:checked) .rc-text {
		color: var(--color-muted);
		text-decoration: line-through;
		text-decoration-color: var(--color-sage);
	}

	li:has(> label .rc-check:checked) .rc-amt,
	li:has(> label .rc-check:checked) .rc-unit {
		color: inherit;
	}

	.rc-step + .rc-step {
		margin-top: var(--space-2xs);
	}

	.rc-step label {
		padding: var(--space-xs) 0;
	}

	.rc-step .rc-text {
		white-space: pre-line;
		font-size: var(--text-lg);
		line-height: 1.6;
	}

	.rc-num {
		font-family: var(--font-display);
		font-weight: 600;
		color: var(--color-moss);
	}

	.rc-step :global(.rc-step-img) {
		max-width: 30rem;
		margin: 0 0 var(--space-sm) calc(1.25rem + var(--space-xs));
		border-radius: var(--radius-md);
	}

	/* Equipment, notes, video */
	.rc-extra {
		margin-top: var(--space-xl);
		padding-top: var(--space-lg);
		border-top: 1px solid var(--color-border);
	}

	.rc-equipment {
		columns: 2 12rem;
		margin: 0;
		padding-left: 1.2em;
	}

	.rc-equipment li::marker {
		color: var(--color-moss);
	}

	.rc-notes :global(.rich-text) {
		font-size: var(--text-base);
	}

	.rc-foot {
		margin-top: var(--space-lg);
		font-size: var(--text-sm);
		color: var(--color-muted);
	}

	.rc-foot p {
		margin: 0 0 var(--space-3xs);
	}

	.rc-credit {
		font-style: italic;
	}

	.rc-reset {
		margin-top: var(--space-sm);
		padding: 0;
		border: 0;
		background: none;
		color: var(--color-link);
		font-weight: 600;
		text-decoration: underline;
		cursor: pointer;
	}
</style>
