---
/** "Shop this post/recipe" band: product cards plus the affiliate disclosure. */
import type { ContentEntry } from "emdash";
import type { Product } from "../../emdash-env";
import ProductCard from "./ProductCard.astro";

interface Props {
	products: ContentEntry<Product>[];
	/** Eyebrow text, e.g. "Shop this post" */
	eyebrow: string;
	heading?: string;
}

const { products, eyebrow, heading = "Things I Used & Love" } = Astro.props;
---

{
	products.length > 0 && (
		<section class="shop-this no-print" aria-labelledby="shop-this-heading">
			<div class="container">
				<div class="section-heading">
					<div>
						<span class="eyebrow">{eyebrow}</span>
						<h2 id="shop-this-heading">{heading}</h2>
					</div>
					<a href="/shop">Visit the shop &rarr;</a>
				</div>
				<div class="product-grid">
					{products.map((product) => (
						<ProductCard product={product} />
					))}
				</div>
				<p class="affiliate-note">
					Some links are affiliate links. As an Amazon Associate, I earn from qualifying purchases,
					at no extra cost to you.
				</p>
			</div>
		</section>
	)
}

<style>
	.shop-this {
		padding-block: var(--space-xl);
		background: var(--color-linen);
		border-block: 1px solid var(--color-border);
	}

	.shop-this .section-heading h2 {
		font-size: var(--text-2xl);
	}

	.product-grid {
		display: grid;
		gap: var(--space-sm);
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	@media (min-width: 48rem) {
		.product-grid {
			grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
			gap: var(--space-md);
		}
	}

	.affiliate-note {
		margin: var(--space-md) 0 0;
		font-size: var(--text-xs);
		color: var(--color-muted);
	}
</style>
