---
/**
 * Newsletter call to action. For now it links to /contact; once the
 * signup endpoint exists this becomes the inline form.
 */
interface Props {
	heading?: string;
	text?: string;
}

const {
	heading = "Join the newsletter family",
	text = "Be the first to know when new recipes, tutorials, and more become available.",
} = Astro.props;
---

<section class="section section--plain newsletter" aria-labelledby="newsletter-heading">
	<div class="container">
		<div class="newsletter-panel newsletter-inner">
			<div class="newsletter-copy">
				<h2 id="newsletter-heading">{heading}</h2>
				<p>{text}</p>
			</div>
			<a class="btn" href="/contact#newsletter">Sign up for the newsletter</a>
		</div>
	</div>
</section>

<style>
	/* A framed linen panel inside the page width (not a full-bleed band), so
	   it stands out by shape and sits cleanly above the footer too. */
	/* Spacing comes from .section / .section--plain (theme.css). */
	.newsletter {
		color: var(--color-olive);
	}

	.newsletter-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md) var(--space-xl);
	}

	.newsletter-panel {
		padding: var(--space-lg);
		border: 1px solid var(--color-sage);
		border-radius: var(--radius-lg);
		background: var(--color-linen);
	}

	@media (min-width: 40rem) {
		.newsletter-panel {
			padding: var(--space-xl);
		}
	}

	.newsletter-copy {
		flex: 1 1 24rem;
	}

	.newsletter h2 {
		margin-bottom: var(--space-2xs);
		font-size: var(--text-2xl);
		color: var(--color-olive);
	}

	.newsletter p {
		margin: 0;
		max-width: 36rem;
	}
</style>
